<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ConDos</RootNamespace>
    <AssemblyName>ConDos</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>../build/</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sharp86DebuggerCore/Sharp86DebuggerCore.csproj" />
    <ProjectReference Include="../Sharp86TextGuiDebugger/Sharp86TextGuiDebugger.csproj" />
    <ProjectReference Include="../Sharp86/Sharp86.csproj" />
  </ItemGroup>
</Project>
